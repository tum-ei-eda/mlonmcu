--- /dev/null
+++ b/lib/ml_interface/common.cmake
@@ -0,0 +1,102 @@
+PROJECT(ml_interface)
+
+LIST(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_SOURCE_DIR})
+
+SET(MLONMCU_BACKEND
+    ""
+    CACHE STRING "Specify which backend to use."
+)
+SET_PROPERTY(CACHE MLONMCU_BACKEND PROPERTY STRINGS tflmc tflmi tvmaot tvmrt tvmcg onnx2c)
+
+SET(MLONMCU_FRAMEWORK
+    ""
+    CACHE STRING "Specify which backend to use."
+)
+SET_PROPERTY(CACHE MLONMCU_FRAMEWORK PROPERTY STRINGS tflm tvm none)
+
+INCLUDE(extras)
+
+IF(TF_DIR)
+    INCLUDE(LinkTFLite)
+ENDIF()
+IF(TVM_DIR)
+    INCLUDE(LinkTVM)
+ENDIF()
+IF(IREE_SRC_DIR)
+    INCLUDE(LinkIREE)
+ENDIF()
+IF(EXECUTORCH_SRC_DIR)
+    INCLUDE(LinkExecutorch)
+ENDIF()
+
+
+INCLUDE(backends/${MLONMCU_BACKEND})
+INCLUDE(frameworks/${MLONMCU_FRAMEWORK})
+
+
+INCLUDE(frameworks/${MLONMCU_FRAMEWORK}_mlif)
+
+IF(MODEL_DIR)
+    IF(NOT MODEL_SUPPORT_FILE AND NOT MODEL_SUPPORT_DIR AND NOT MODEL_SUPPORT_LIB)
+        GET_FILENAME_COMPONENT(MODEL_SUPPORT_DIR ${MODEL_DIR}/support REALPATH)
+    ENDIF()
+    GET_FILENAME_COMPONENT(MODEL_NAME ${MODEL_DIR} NAME)
+ENDIF()
+
+IF(TEMPLATE_VERSION STREQUAL "v2")
+    COMMON_ADD_LIBRARY(${PROJECT_NAME}_base STATIC ml_interface_base.c)
+    TARGET_LINK_LIBRARIES(${PROJECT_NAME}_base PUBLIC support ${EXTRA_LIBS})
+    TARGET_INCLUDE_DIRECTORIES(${PROJECT_NAME}_base PUBLIC . ${EXTRA_INCS})
+    ADD_SUBDIRECTORY(mlifio)
+    IF(MODEL_SUPPORT_FILE AND EXISTS "${MODEL_SUPPORT_FILE}")
+        COMMON_ADD_LIBRARY(model_support STATIC ${MODEL_SUPPORT_FILE})
+        TARGET_LINK_LIBRARIES(model_support PUBLIC support mlifio)
+    ELSEIF(MODEL_SUPPORT_LIB AND EXISTS "${MODEL_SUPPORT_LIB}")
+        COMMON_ADD_LIBRARY(model_support INTERFACE)
+        TARGET_LINK_LIBRARIES(model_support INTERFACE ${MODEL_SUPPORT_LIB})
+    ELSEIF(MODEL_SUPPORT_DIR AND EXISTS "${MODEL_SUPPORT_DIR}")
+        ADD_SUBDIRECTORY(${MODEL_SUPPORT_DIR} custom_model_support)
+    ELSE()
+        ADD_SUBDIRECTORY(default_model_support)
+    ENDIF()
+ELSE()
+    IF(MODEL_SUPPORT_DIR AND EXISTS "${MODEL_SUPPORT_DIR}")
+        ADD_SUBDIRECTORY(${MODEL_SUPPORT_DIR} model_support_bin_${MODEL_NAME})
+    ELSE()
+        ADD_SUBDIRECTORY(default_model_support)
+    ENDIF()
+    IF(NOT DATA_SRC)
+        SET(DATA_SRC "default_data.c")
+    ENDIF()
+    COMMON_ADD_LIBRARY(${PROJECT_NAME}_base STATIC ${DATA_SRC})
+    TARGET_LINK_LIBRARIES(${PROJECT_NAME}_base PUBLIC support ${EXTRA_LIBS})
+    TARGET_INCLUDE_DIRECTORIES(${PROJECT_NAME}_base PUBLIC . ${EXTRA_INCS})
+ENDIF()
+
+COMMON_ADD_LIBRARY(${PROJECT_NAME} STATIC ml_interface.c ${EXTRA_SRCS})
+IF(DEFINED EXTRA_DEPS)
+    ADD_DEPENDENCIES(${PROJECT_NAME} ${EXTRA_DEPS})
+ENDIF()
+TARGET_LINK_LIBRARIES(${PROJECT_NAME} PUBLIC ${PROJECT_NAME}_base model_support target_support)
+TARGET_INCLUDE_DIRECTORIES(${PROJECT_NAME} PUBLIC . ${EXTRA_INCS})
+IF(NUM_RUNS)
+    TARGET_COMPILE_DEFINITIONS(${PROJECT_NAME} PUBLIC NUM_RUNS=${NUM_RUNS})
+ENDIF()
+IF(BATCH_SIZE)
+    TARGET_COMPILE_DEFINITIONS(${PROJECT_NAME} PUBLIC BATCH_SIZE=${BATCH_SIZE})
+ENDIF()
+# Used to detect legacy mlonmcu versions
+ADD_DEFINITIONS(-DMLONMCU_MODEL_SUPPORT)
+
+IF(${GLOBAL_ISEL})
+target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:$<$<COMPILE_LANGUAGE:C>:-mllvm -global-isel=1>")
+target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:$<$<COMPILE_LANGUAGE:CXX>:-mllvm -global-isel=1>")
+SET(GLOBAL_ISEL_ABORT 2)
+target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:$<$<COMPILE_LANGUAGE:C>:-mllvm -global-isel-abort=${GLOBAL_ISEL_ABORT}>")
+target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:$<$<COMPILE_LANGUAGE:CXX>:-mllvm -global-isel-abort=${GLOBAL_ISEL_ABORT}>")
+ENDIF()
+
+# TODO: check if required for executorch?
+# target_compile_definitions(
+#   ml_interface PRIVATE C10_USING_CUSTOM_GENERATED_MACROS
+# )
